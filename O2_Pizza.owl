<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/thesis/O2#"
     xml:base="http://example.org/thesis/O2"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="http://example.org/thesis/O2"/>

  <owl:Class rdf:about="http://example.org/thesis/O2#PizzaBase"/>
  <owl:Class rdf:about="http://example.org/thesis/O2#Pizza">
    <rdfs:subClassOf rdf:resource="http://example.org/thesis/O2#PizzaBase"/>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/thesis/O2#NamedPizza">
    <rdfs:subClassOf rdf:resource="http://example.org/thesis/O2#Pizza"/>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/thesis/O2#SohoPizza">
    <rdfs:subClassOf rdf:resource="http://example.org/thesis/O2#NamedPizza"/>
    <owl:disjointWith rdf:resource="http://example.org/thesis/O2#MargheritaPizza"/>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/thesis/O2#MargheritaPizza">
    <rdfs:subClassOf rdf:resource="http://example.org/thesis/O2#NamedPizza"/>
  </owl:Class>

  <owl:ObjectProperty rdf:about="http://example.org/thesis/O2#HasBase"/>
  <owl:DatatypeProperty rdf:about="http://example.org/thesis/O2#CaloricValue"/>

  <owl:NamedIndividual rdf:about="http://example.org/thesis/O2#SohoPizza1">
    <rdf:type rdf:resource="http://example.org/thesis/O2#SohoPizza"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/thesis/O2#SohoPizza2">
    <rdf:type rdf:resource="http://example.org/thesis/O2#SohoPizza"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/thesis/O2#MargheritaP1">
    <rdf:type rdf:resource="http://example.org/thesis/O2#MargheritaPizza"/>
  </owl:NamedIndividual>

</rdf:RDF>
