<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/thesis/O1#"
     xml:base="http://example.org/thesis/O1"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="http://example.org/thesis/O1"/>

  <owl:Class rdf:about="http://example.org/thesis/O1#PizzaBasis"/>
  <owl:Class rdf:about="http://example.org/thesis/O1#Pizza">
    <rdfs:subClassOf rdf:resource="http://example.org/thesis/O1#PizzaBasis"/>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/thesis/O1#AppointedPizza">
    <rdfs:subClassOf rdf:resource="http://example.org/thesis/O1#Pizza"/>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/thesis/O1#SohoPizza">
    <rdfs:subClassOf rdf:resource="http://example.org/thesis/O1#AppointedPizza"/>
    <owl:disjointWith rdf:resource="http://example.org/thesis/O1#MargheritaPizza"/>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/thesis/O1#MargheritaPizza">
    <rdfs:subClassOf rdf:resource="http://example.org/thesis/O1#AppointedPizza"/>
  </owl:Class>

  <owl:ObjectProperty rdf:about="http://example.org/thesis/O1#HasBase"/>
  <owl:DatatypeProperty rdf:about="http://example.org/thesis/O1#CaloricContent"/>

  <owl:NamedIndividual rdf:about="http://example.org/thesis/O1#SohoPizza1">
    <rdf:type rdf:resource="http://example.org/thesis/O1#SohoPizza"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/thesis/O1#SohoPizza2">
    <rdf:type rdf:resource="http://example.org/thesis/O1#SohoPizza"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://example.org/thesis/O1#MargheritaP1">
    <rdf:type rdf:resource="http://example.org/thesis/O1#MargheritaPizza"/>
  </owl:NamedIndividual>

</rdf:RDF>
